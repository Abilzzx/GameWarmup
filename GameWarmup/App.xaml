<Application x:Class="GameWarmup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0A1020"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#17233B"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#316BE4"/><Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,10"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#35445F"/>
          <Setter Property="Foreground" Value="#AEBED8"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,6,0,10"/><Setter Property="Padding" Value="8"/>
      <Setter Property="Foreground" Value="#101A2D"/><Setter Property="Background" Value="#EDF4FF"/>
      <Setter Property="BorderBrush" Value="#8297C0"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#101A2D"/><Setter Property="Background" Value="#EDF4FF"/>
      <Setter Property="Padding" Value="8,7"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#C6DDFB"/><Setter Property="Foreground" Value="#101A2D"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#B4D0F7"/><Setter Property="Foreground" Value="#101A2D"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,8"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#316BE4"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#263953"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3E5376"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8F0FF"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  </Application.Resources>
</Application>
